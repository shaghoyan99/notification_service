<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-notification-table" author="Vahe Hovhannisyan">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="notification" schemaName="notification_service"/>
            </not>
        </preConditions>

        <createTable tableName="notification" schemaName="notification_service">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="int8">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="title_message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="reference_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_id" type="int8">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="notification-table-rollback" author="Vahe Hovhannisyan">
        <rollback>
            <dropTable tableName="notification"
                       schemaName="notification_service"
                       cascadeConstraints="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>